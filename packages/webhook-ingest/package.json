  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": { "extensiv-webhook-ingest": "./dist/cli.js" },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@mcp-3pl/core": "workspace:*",
    "hono": "^4.11.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
