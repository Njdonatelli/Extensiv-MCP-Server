{
  "name": "extensiv-mcp-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Extensiv 3PL Warehouse Manager MCP server: reusable core + Extensiv adapter + mock API + webhook ingest",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts",
    "mock": "pnpm --filter @mcp-3pl/mock-extensiv start",
    "server": "pnpm --filter extensiv-mcp-server start",
    "webhook-ingest": "pnpm --filter @mcp-3pl/webhook-ingest start",
    "evals": "tsx evals/run.ts",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
